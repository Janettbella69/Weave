# Weave 网站，给自己管的服务器用：Worker 用 `wrangler dev --local` 跑，D1 存在 /app/.wrangler/state。
# 构建在镜像里完成，服务器上不需要装 Node。部署方式见 deploy/tencent/README.md。
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY drizzle ./drizzle
COPY scripts/start-vps.sh scripts/notion-oauth-proxy.mjs ./scripts/
RUN chmod +x ./scripts/start-vps.sh && mkdir -p /app/.wrangler/state && chown -R node:node /app
USER node
# X_LOCAL_EXPLORER=false：关掉 wrangler 自带的本机数据浏览器（/cdn-cgi/explorer）。它在 Worker 之前处理请求、
# 不经过访问密码，同一台机器上的其他容器带上 Host: localhost 就能读写整个数据库。
ENV NODE_ENV=production PORT=4317 HOST=0.0.0.0 X_LOCAL_EXPLORER=false
EXPOSE 4317
CMD ["./scripts/start-vps.sh"]
