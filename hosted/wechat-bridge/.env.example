# Where Weave runs. https only (127.0.0.1 is allowed for local tests).
WEAVE_ORIGIN=https://weave.azorashopping.site
# Same value as WECHAT_BRIDGE_TOKEN on the Weave side (at least 32 characters).
# deploy/wechat-mac/set-token.sh generates it and writes both sides without showing it.
WECHAT_BRIDGE_TOKEN=
# Where the agent-wechat daemon listens. The Mac setup uses port 6179; agent-wechat's own default is 6174.
WX_BASE_URL=http://127.0.0.1:6174/v1
# wx tokens create weave-bridge --accounts ACCOUNT_ID --scopes read --scopes send
WX_TOKEN=
# The id from: wx accounts list
WX_ACCOUNT=
# Set to 1 when Weave runs on `wrangler dev`, where Cron does not fire. Leave unset on Cloudflare.
WEAVE_TICK=
# Where the bridge remembers how far it has read (default: .data/cursor.json next to bridge.mjs).
# WECHAT_BRIDGE_STATE=
# Send limits. agent-wechat has none and WeChat's risk control is unverified, so these are conservative guesses.
# A value that is not a positive whole number keeps the default.
# WECHAT_SEND_PER_CHAT_PER_MIN=6
# WECHAT_SEND_TOTAL_PER_MIN=12
# WECHAT_SEND_PER_DAY=200
# WECHAT_SEND_MIN_GAP_MS=1500
# WECHAT_SEND_MAX_HOLD_MS=600000
