# Configure production through Sites environment variables, not source control.
# Local Worker preview uses ignored .dev.vars instead.
WEAVE_ENCRYPTION_KEY=
# Optional separately hosted Node Claude Agent SDK service.
AGENT_SERVICE_URL=
AGENT_SERVICE_TOKEN=
# Optional provider credential for a fully managed Agent connection.
AGENT_PROVIDER_API_KEY=
# Shared secret for the local WeChat bridge (hosted/wechat-bridge), at least 32 characters.
WECHAT_BRIDGE_TOKEN=
# Optional Notion OAuth connection. These stay in the hosting secret store.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://weave.example/api/connections/notion/callback
NOTION_PUBLIC_ORIGIN=https://weave.example
# Runner shared secret for the separate Hermes process.
HERMES_RUNNER_TOKEN=
