AGENT_SERVICE_TOKEN=
# Each person's workspace, session map and the token ledger live here. Keep it out of git and back it up.
AGENT_DATA_DIR=./data
# docker (default): one throwaway container per wake, built from Dockerfile.agent.
# local: SDK sandbox only, for development on a machine without Docker.
AGENT_ISOLATION=docker
AGENT_IMAGE=weave-agent:0.3.316
# The Weave service the MCP tools call back into (POST /api/internal/agent/tools/<name>).
WEAVE_API_URL=http://127.0.0.1:8787
# Managed model keys. Only the model proxy inside this service reads them; the CLI never sees them.
# DEEPSEEK_API_KEY falls back to AGENT_PROVIDER_API_KEY.
DEEPSEEK_API_KEY=
AGENT_PROVIDER_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
# Daily token ceilings for managed keys (draft numbers, to be confirmed). Own-key users are not counted.
AGENT_DAILY_TOKENS_PER_ACCOUNT=400000
AGENT_DAILY_TOKENS_TOTAL=6000000
AGENT_MAX_CONCURRENCY=3
HOST=127.0.0.1
PORT=4320
