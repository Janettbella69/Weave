PORT=4317
# Optional: without these, clearly labeled rule-based demo mode is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Share this parent page with your Notion integration.
NOTION_TOKEN=
NOTION_PAGE_ID=

# Gewechat: a reachable, separately provisioned service is required.
# Base URL includes /v2/api. Remote services require HTTPS.
GEWECHAT_BASE_URL=
GEWECHAT_TOKEN=
GEWECHAT_APP_ID=
# Exactly one authorized personal user; groups and other users are ignored.
GEWECHAT_OWNER_WXID=
# Generate: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
GEWECHAT_CALLBACK_SECRET=
# Only this callback listener may be exposed through an HTTPS reverse proxy.
GEWECHAT_WEBHOOK_HOST=127.0.0.1
GEWECHAT_WEBHOOK_PORT=4318
GEWECHAT_PUBLIC_ORIGIN=
# Used only for explicit CLI login commands.
GEWECHAT_LOGIN_UUID=
GEWECHAT_LOGIN_CODE=
